{
  "AllowedHosts": "localhost;127.0.0.1",
  "DemoMode": {
    "Enabled": false
  },
  "Persistence": {
    "ApplyMigrationsOnStartup": false
  },
  "Observability": {
    "ConsoleFormat": "Json"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Fatal",
        "Npgsql": "Fatal",
        "Microsoft.Extensions.Hosting.Internal.Host": "Fatal",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  }
}
